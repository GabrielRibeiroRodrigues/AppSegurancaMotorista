# Copie para .env NA VPS e preencha. NUNCA commite o .env real.
# Gere a SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

DEBUG=False
# IP público da sua VPS (e domínio, se tiver). Separe por vírgula.
ALLOWED_HOSTS=SEU_IP_DA_VPS

# PostgreSQL (use uma senha forte)
POSTGRES_DB=copiloto
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432
