# Copie para .env NA VPS e preencha. NUNCA commite o .env real.
# Gere a SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

DEBUG=False
# IP público da sua VPS (e domínio, se tiver). Separe por vírgula.
ALLOWED_HOSTS=SEU_IP_DA_VPS

# Porta no host da VPS. Troque se a 8000 já estiver em uso por outro serviço.
WEB_PORT=8000

# PostgreSQL (use uma senha forte)
POSTGRES_DB=copiloto
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Produção endurecida (só com docker-compose.tls.yml) ---
# Deixe em branco/omita enquanto estiver rodando por HTTP em IP:8000.
# Domínio apontando para a VPS (necessário para HTTPS automático via Caddy).
CADDY_DOMAIN=
# Ativa cookies seguros + HSTS no Django (defina True quando estiver atrás do TLS/Caddy).
SECURE_SSL=False
# Origem(ns) do dashboard web autorizadas no CORS (ex.: https://copiloto.seudominio.com).
CORS_ALLOWED_ORIGINS=
# TURN (vídeo ao vivo em redes difíceis). PUBLIC_IP = IP público da VPS.
PUBLIC_IP=
TURN_USERNAME=copiloto
TURN_PASSWORD=
# (Opcional) limites de requisições por minuto.
# THROTTLE_ANON=40/min
# THROTTLE_USER=240/min
# THROTTLE_AUTH=10/min
