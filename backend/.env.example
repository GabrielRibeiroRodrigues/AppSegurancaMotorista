# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=copiloto
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=copiloto
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comma-separated, only needed when DEBUG=False and a browser calls the API.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
