# Copie para android/keystore.properties (NÃO commitar) para assinar o release.
# 1) Gere a chave (uma vez), guarde o .jks em local seguro:
#    keytool -genkeypair -v -keystore copiloto-release.jks -alias copiloto \
#            -keyalg RSA -keysize 2048 -validity 10000
# 2) Preencha os caminhos/senhas abaixo e rode:
#    ./gradlew assembleRelease -PversionCode=2 -PversionName=1.1.0
storeFile=/caminho/para/copiloto-release.jks
storePassword=senha-do-keystore
keyAlias=copiloto
keyPassword=senha-da-chave
