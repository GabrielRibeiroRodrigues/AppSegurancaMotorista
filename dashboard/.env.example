# URL do backend Django do Copiloto.
# Dev (dashboard no PC, backend local): http://localhost:8000
# Produção: http://SEU_IP_DA_VPS:8000
VITE_SERVER_URL=http://localhost:8000

# (Opcional) URL do servidor de sinalizacao WebRTC. Padrao: host da API na porta 4001.
# Ex.: ws://191.252.100.161:4001/signaling
VITE_SIGNALING_URL=

# (Opcional) Servidor TURN para o video ao vivo fechar conexao em redes dificeis
# (4G/NAT simetrico). Sem isso, so STUN — muitas conexoes de celular falham.
# Ex.: turn:191.252.100.161:3478
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Obs.: a Central agora exige LOGIN de operador (conta is_staff no Django admin).
